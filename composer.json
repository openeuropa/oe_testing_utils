{
  "name": "openeuropa/oe_testing_utils",
  "homepage": "https://github.com/openeuropa/oe_testing_utils",
  "description": "Testing utilities for OpenEuropa projects",
  "type": "library",
  "license": "EUPL-1.2",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "composer/installers": "^2.3",
    "openeuropa/code-review": "^2.0.0",
    "drupal/core": "^10.6 || ^11",
    "drupal/core-dev": "^10.6 || ^11",
    "ec-europa/toolkit": "^10.23",
    "drupal/core-composer-scaffold": "^10.6 || ^11"
  },
  "scripts": {
    "post-install-cmd": "./vendor/bin/run drupal:site-setup",
    "post-update-cmd": "./vendor/bin/run drupal:site-setup"
  },
  "autoload": {
    "psr-4": {
      "OpenEuropa\\TestingUtilities\\": "./src/"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "ec-europa/toolkit-composer-plugin": true,
      "php-http/discovery": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true,
      "tbachert/spi": true,
      "composer/installers": true
    }
  },
  "extra": {
    "composer-exit-on-patch-failure": true,
    "enable-patching": true,
    "installer-paths": {
      "build/core": ["type:drupal-core"],
      "build/profiles/contrib/{$name}": ["type:drupal-profile"],
      "build/modules/contrib/{$name}": ["type:drupal-module"],
      "build/themes/contrib/{$name}": ["type:drupal-theme"]
    },
    "drupal-scaffold": {
      "locations": {
        "web-root": "./build"
      }
    }
  }
}
